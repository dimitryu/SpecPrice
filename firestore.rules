rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // The caller's own profile. Every permission below is read from it, so
    // the profile is the one document its owner must NOT be able to shape:
    // see users/{uid} — only an admin (in practice the userAdmin function)
    // writes role, company_id or disabled.
    function myProfilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function hasProfile() {
      return isSignedIn() && exists(myProfilePath());
    }
    function me() {
      return get(myProfilePath()).data;
    }

    // A sign-in account alone grants nothing: there must be a profile, and it
    // must not be disabled. A disabled user is locked out of every collection
    // at once, whatever their role, and even while an old token is still valid.
    function isActive() {
      return hasProfile() && me().get('disabled', false) != true;
    }

    function myCompanyId() {
      return me().get('company_id', '');
    }

    function myRole() {
      return me().get('role', '');
    }

    function isAdmin() {
      return isActive() && myRole() == 'admin';
    }

    function isSameCompany(cid) {
      return isActive() && myCompanyId() == cid;
    }

    // An admin is the admin of THEIR company — not of every company in the
    // project. (Settings > Roles, the company list and the shared API keys
    // stay with any admin: this is a single-company deployment.)
    function isCompanyAdmin(cid) {
      return isAdmin() && myCompanyId() == cid;
    }

    // Roles are enforced here, not only by which buttons the screen shows.
    // 'viewer' is read-only by definition; any other role is read-only when
    // its roles/{key} document says read_only: true (Settings > Roles). An
    // admin is never read-only.
    function myRoleIsReadOnly() {
      let rp = /databases/$(database)/documents/roles/$(myRole());
      return myRole() == 'viewer'
          || (exists(rp) && get(rp).data.get('read_only', false) == true);
    }
    function canEdit(cid) {
      return isCompanyAdmin(cid) || (isSameCompany(cid) && myRole() != 'admin' && !myRoleIsReadOnly());
    }

    // Recycle bin: a document may be marked deleted only with deletedAtMs
    // = now (±10 min), and an item already in the bin keeps its time. Without
    // this anyone could write deletedAtMs: 0 and the next admin to open the
    // Database would purge the part for good as "past its retention".
    function trashTimeOk() {
      let d = request.resource.data;
      let now = request.time.toMillis();
      let wasDeleted = resource != null && resource.data.get('deleted', false) == true;
      return d.get('deleted', false) != true
          || (wasDeleted && d.get('deletedAtMs', 0) == resource.data.get('deletedAtMs', 0))
          || ((d.get('deletedAtMs', 0) is int || d.get('deletedAtMs', 0) is float)
              && d.get('deletedAtMs', 0) > now - 600000 && d.get('deletedAtMs', 0) < now + 600000);
    }

    // ── users/{uid} ──────────────────────────────────────────────────────
    // Read: your own profile (the app checks role / company / disabled at
    // sign-in — a disabled user must still be able to read that they are
    // disabled), or any profile for an admin (Settings > Users).
    //
    // Write: ONLY an admin creates, changes or deletes a profile. A user may
    // change their own screen settings (ui_prefs) and nothing else — not
    // role, not company_id, not disabled. Before this, "write your own
    // profile" let anyone with a sign-in account make themselves admin.
    match /users/{uid} {
      allow read: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
      allow update: if isSignedIn() && request.auth.uid == uid && isActive()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ui_prefs', 'updatedAt']);
      // Admin writes (in practice the userAdmin function, which applies the
      // same limits) stay inside the admin's own company.
      allow create: if isAdmin() && request.resource.data.get('company_id', '') == myCompanyId();
      allow update: if isAdmin() && resource.data.get('company_id', '') in [myCompanyId(), '']
                    && request.resource.data.get('company_id', '') == myCompanyId();
      allow delete: if isAdmin() && resource.data.get('company_id', '') in [myCompanyId(), ''];
    }

    // ── companies/{cid} ──────────────────────────────────────────────────
    // Any ACTIVE user (signed in, with an enabled profile) may read company
    // docs — this is required for the first-login "pick your company" screen,
    // which lists all companies by name before the user has a company_id yet.
    // Only the company's admin may change it.
    //
    // CAVEAT: older company docs may still hold anthropic_key / gemini_key
    // (moved to the server since); any active user can read company docs.
    match /companies/{cid} {
      allow read: if isActive();
      // Labor rate, logo, recycle-bin retention: the company's admin only.
      // Every member could change them before, and a changed labor rate
      // silently changes every quote.
      allow update: if isCompanyAdmin(cid);
      allow create, delete: if isAdmin();
    }

    // ── companies/{cid}/parts_cache/{id}  (Database) ─────────────────────
    // Everyone in the company reads it; editors (not viewers / read-only
    // roles) add and change parts, and "Delete Selected" only moves a part
    // to the recycle bin (an update). Removing a part for good — by hand or
    // after the retention period — is the company admin's alone.
    match /companies/{cid}/parts_cache/{docId} {
      allow read: if isSameCompany(cid);
      allow create, update: if canEdit(cid) && trashTimeOk();
      allow delete: if isCompanyAdmin(cid);
    }

    // ── companies/{cid}/projects/{id}  (RFQs) + nested drawings (BOMs) ────
    // Same pattern: editors work and move to the recycle bin; only the
    // company admin deletes for good (Admin > Recycle Bin).
    match /companies/{cid}/projects/{docId} {
      allow read: if isSameCompany(cid);
      allow create, update: if canEdit(cid) && trashTimeOk();
      allow delete: if isCompanyAdmin(cid);

      match /drawings/{drawingId} {
        allow read: if isSameCompany(cid);
        allow create, update: if canEdit(cid) && trashTimeOk();
        allow delete: if isCompanyAdmin(cid);
      }
    }

    // ── companies/{cid}/cut_strip_specs/{id}  (Cut & Strip + manufacturing) ─
    // Doc id is the sanitised drawing number, so re-analysing a drawing updates
    // its sheet instead of creating a near-duplicate. The bench reads them
    // (viewer); editors create and change them; deleting goes by the bin.
    match /companies/{cid}/cut_strip_specs/{docId} {
      allow read: if isSameCompany(cid);
      allow create, update: if canEdit(cid) && trashTimeOk();
      allow delete: if isCompanyAdmin(cid);
    }

    // ── companies/{cid}/customers/{id} ─────────────────────────────────────
    match /companies/{cid}/customers/{docId} {
      allow read: if isSameCompany(cid);
      allow create, update: if canEdit(cid) && trashTimeOk();
      allow delete: if isCompanyAdmin(cid);
    }

    // ── companies/{cid}/support_tickets/{id}  (floating Support button) ────
    // Every member, viewers included, can open a ticket and follow it up —
    // asking for help is not editing company data. Nobody but the company
    // admin can delete one (the app never does).
    match /companies/{cid}/support_tickets/{docId} {
      allow read, create, update: if isSameCompany(cid);
      allow delete: if isCompanyAdmin(cid);
    }

    // ── companies/{cid}/audit_logs/{id}  (Admin > Logs) ─────────────────────
    // Any member of the company can CREATE a log entry (every screen open /
    // login / action needs to write one) but only admins can READ the log —
    // it's an audit trail, not something regular users should be able to
    // browse. No update/delete for anyone — logs are append-only.
    match /companies/{cid}/audit_logs/{docId} {
      allow create: if isSameCompany(cid);
      allow read: if isCompanyAdmin(cid);
    }

    // ── roles/{roleKey}  (Settings > Roles: per-role button visibility) ────
    // Any active user must be able to read this so the Home screen can
    // gate which buttons THEY see based on their own role. Only admins may
    // create/edit roles.
    match /roles/{roleKey} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // ── secure_config/{docId}  (Mouser / DigiKey / Anthropic API keys) ────
    // ai_api holds the Anthropic key; only the aiProxy / apiConfig functions
    // read or write it.
    // Denied to EVERY client, including admins. That is intentional, not an
    // oversight: these credentials are only ever used by the priceLookup Cloud
    // Function, which talks to Firestore through the Admin SDK and therefore
    // bypasses these rules entirely.
    //
    // Because no browser can read this path, a stolen session, an XSS bug, or
    // a curious user poking at the SDK in devtools still cannot extract the
    // keys. Admins manage them through the apiConfig function, which accepts
    // new values and returns only a "configured / not configured" status.
    //
    // Do NOT relax this to `if isAdmin()` for convenience — that would put the
    // credentials back within reach of anything running in an admin's browser.
    match /secure_config/{docId} {
      allow read, write: if false;
    }

    // ── Legacy root-level collections (pre-company-namespace data) ────────
    // Only touched by the admin "Clean Legacy Data" maintenance action in
    // Settings > Companies. Locked to admins only.
    match /customers/{docId} {
      allow read, write: if isAdmin();
    }
    match /projects/{docId} {
      allow read, write: if isAdmin();
      match /drawings/{drawingId} {
        allow read, write: if isAdmin();
      }
    }
    match /parts_cache/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
