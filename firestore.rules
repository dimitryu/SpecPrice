rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myCompanyId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.company_id;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }

    function isSameCompany(cid) {
      return isSignedIn() && myCompanyId() == cid;
    }

    // ── users/{uid} ──────────────────────────────────────────────────────
    // A user can always read/write their own profile (needed so the app can
    // check role/company_id/disabled on login, and so admins can be looked
    // up). Admins can read/write ANY user profile — required by
    // Settings > Users (list all users, invite, edit role/company, disable,
    // delete).
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }

    // ── companies/{cid} ──────────────────────────────────────────────────
    // Any signed-in user may read company docs — this is required for the
    // first-login "pick your company" screen, which lists all companies by
    // name before the user has a company_id yet.
    // Only members of that company, or an admin, may write to it.
    //
    // CAVEAT: company docs currently also store anthropic_key, gemini_key
    // and labor_rate_min. Because `read` is granted broadly above, those
    // fields are technically readable by any signed-in user of ANY company,
    // not just members of that company. If that's not acceptable, move
    // those three fields into a locked-down subdocument, e.g.
    // companies/{cid}/private/settings, readable only by isSameCompany(cid)
    // — this requires an app.html change (initCompany / Settings save) to
    // read/write that subdocument instead. Not done here since it wasn't
    // explicitly requested and changes the data model.
    match /companies/{cid} {
      allow read: if isSignedIn();
      allow update: if isSameCompany(cid) || isAdmin();
      allow create, delete: if isAdmin();
    }

    // ── companies/{cid}/parts_cache/{id}  (Part Stock) ────────────────────
    match /companies/{cid}/parts_cache/{docId} {
      // Anyone in the company reads and edits the Database. Removing a part
      // for good is an admin's call: the app's "Delete Selected" only moves a
      // part to the recycle bin (an update), and the permanent purge — manual
      // or after the retention period — runs from an admin session.
      allow read, create, update: if isSameCompany(cid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── companies/{cid}/projects/{id}  (RFQs) + nested drawings (BOMs) ────
    match /companies/{cid}/projects/{docId} {
      allow read, write: if isSameCompany(cid) || isAdmin();

      match /drawings/{drawingId} {
        allow read, write: if isSameCompany(cid) || isAdmin();
      }
    }

    // ── companies/{cid}/cut_strip_specs/{id}  (Cut & Strip) ────────────────
    // Doc id is the sanitised drawing number, so re-analysing a drawing updates
    // its sheet instead of creating a near-duplicate.
    //
    // Read and write are both company-scoped rather than admin-only on purpose:
    // the whole point of these sheets is that the person at the bench opens one,
    // and the 'viewer' role exists for exactly that kind of shop-floor account.
    // Write stays open to the company because generating a sheet from a drawing
    // is normal production work, not administration.
    match /companies/{cid}/cut_strip_specs/{docId} {
      allow read, write: if isSameCompany(cid) || isAdmin();
    }

    // ── companies/{cid}/customers/{id} ─────────────────────────────────────
    match /companies/{cid}/customers/{docId} {
      allow read, write: if isSameCompany(cid) || isAdmin();
    }

    // ── companies/{cid}/support_tickets/{id}  (floating Support button) ────
    // Any member of the company can create a ticket and read/update tickets
    // (needed so the Support modal can show the submitting user their own
    // past tickets + admin replies). Only admins actually use the Admin page
    // to change status/reply, but write access isn't restricted to admin-only
    // here since a user re-opening their own resolved ticket, etc. is
    // reasonable — tighten to admin-only writes on status/reply fields later
    // if that turns out to matter.
    match /companies/{cid}/support_tickets/{docId} {
      allow read, write: if isSameCompany(cid) || isAdmin();
    }

    // ── companies/{cid}/audit_logs/{id}  (Admin > Logs) ─────────────────────
    // Any member of the company can CREATE a log entry (every screen open /
    // login / action needs to write one) but only admins can READ the log —
    // it's an audit trail, not something regular users should be able to
    // browse. No update/delete for anyone — logs are append-only.
    match /companies/{cid}/audit_logs/{docId} {
      allow create: if isSameCompany(cid) || isAdmin();
      allow read: if isAdmin();
    }

    // ── roles/{roleKey}  (Settings > Roles: per-role button visibility) ────
    // Any signed-in user must be able to read this so the Home screen can
    // gate which buttons THEY see based on their own role. Only admins may
    // create/edit roles.
    match /roles/{roleKey} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── secure_config/{docId}  (Mouser / DigiKey / Anthropic API keys) ────
    // ai_api holds the Anthropic key; only the aiProxy / apiConfig functions
    // read or write it.
    // Denied to EVERY client, including admins. That is intentional, not an
    // oversight: these credentials are only ever used by the priceLookup Cloud
    // Function, which talks to Firestore through the Admin SDK and therefore
    // bypasses these rules entirely.
    //
    // Because no browser can read this path, a stolen session, an XSS bug, or
    // a curious user poking at the SDK in devtools still cannot extract the
    // keys. Admins manage them through the apiConfig function, which accepts
    // new values and returns only a "configured / not configured" status.
    //
    // Do NOT relax this to `if isAdmin()` for convenience — that would put the
    // credentials back within reach of anything running in an admin's browser.
    match /secure_config/{docId} {
      allow read, write: if false;
    }

    // ── Legacy root-level collections (pre-company-namespace data) ────────
    // Only touched by the admin "Clean Legacy Data" maintenance action in
    // Settings > Companies. Locked to admins only.
    match /customers/{docId} {
      allow read, write: if isAdmin();
    }
    match /projects/{docId} {
      allow read, write: if isAdmin();
      match /drawings/{drawingId} {
        allow read, write: if isAdmin();
      }
    }
    match /parts_cache/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
